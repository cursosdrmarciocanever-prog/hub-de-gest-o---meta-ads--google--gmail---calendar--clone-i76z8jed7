# Build do front (Vite) -> servido por nginx, que tambem faz proxy do PocketBase.
# As VITE_* sao "baked" no build (Vite injeta em tempo de compilacao).

FROM node:22-alpine AS build
WORKDIR /app
COPY . .
ARG VITE_POCKETBASE_URL
ENV VITE_POCKETBASE_URL=$VITE_POCKETBASE_URL
# --legacy-peer-deps tolera conflitos de peerDependency opcionais (ex.: valibot
# exigido por @hookform/resolvers) que o resolver estrito do npm rejeitaria.
# react-is: dependencia do recharts (2.x) que some da arvore apos os bumps do
# Skip; instalada explicitamente (--no-save) para o Vite conseguir resolver.
RUN npm install --legacy-peer-deps \
  && npm install --no-save --legacy-peer-deps react-is \
  && npm run build

FROM nginx:alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
