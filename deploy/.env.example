# Copie para deploy/.env na VPS e ajuste. NAO commitar o .env real.

# Versao do PocketBase — DEVE bater com a do goskip (veja no rodape de /_/).
# O CRM, mesmo template, roda 0.36.9.
PB_VERSION=0.36.9
# Arquitetura do binario. VPS x86_64 = linux_amd64 (padrao). ARM = linux_arm64.
PB_ARCH=linux_amd64

# Dominio publico do hub (front + API na mesma origem).
HUB_HOST=hub.clinicacanever.com.br
HUB_URL=https://hub.clinicacanever.com.br

# Nome do certresolver do Traefik NESTA VPS (2.24.107.183).
# Conferido em /docker/apps/crm/deploy/.env — nao e' `letsencrypt`.
CERT_RESOLVER=mytlschallenge
